+using System.Text;
+using EMF.Core.Models.Identities;
+
+namespace EMF.Tests;
+
+public sealed class IdentityEncodingHardeningTests
+{
+    [Fact]
+    public void ArtifactId_RejectsMalformedUnicodeThatAliasesAnotherAuthenticatedIdentity()
+    {
+        // Default UTF-8 replacement fallback turns distinct UTF-16 strings into
+        // identical bytes, including the bytes used for artifact authentication.
+        var replacement = "artifact-\uFFFD";
+        foreach (var malformed in new[] { "artifact-\uD800", "artifact-\uDC00" })
+        {
+            Assert.NotEqual(replacement, malformed);
+            Assert.Equal(Encoding.UTF8.GetBytes(replacement), Encoding.UTF8.GetBytes(malformed));
+            Assert.Throws<ArgumentException>(() => new ArtifactId(malformed));
+        }
+    }
+
+    [Fact]
+    public void ArtifactId_PreservesValidUnicodeWithoutNormalization()
+    {
+        foreach (var value in new[] { "artifact-\U0001F4C4", "artifact-é", "artifact-e\u0301", "artifact-\uFFFD" })
+            Assert.Equal(value, new ArtifactId(value).Value);
+        Assert.NotEqual(new ArtifactId("artifact-é"), new ArtifactId("artifact-e\u0301"));
+    }
+}
